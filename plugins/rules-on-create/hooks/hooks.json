{
  "description": "新規ファイル作成時にルールが該当する場合のみ Write を deny し、Read を強制することでパスベースのルールを context に注入させる",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/pre-write-force-read.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
