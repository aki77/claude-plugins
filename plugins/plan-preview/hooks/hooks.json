{
  "description": "ExitPlanMode の承認ダイアログ直前にプランファイルを mo でブラウザに開く（判定には干渉しない）",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/render-plan.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
