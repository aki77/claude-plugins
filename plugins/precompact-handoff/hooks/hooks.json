{
  "description": "SessionStart(compact) で圧縮直前の会話ログの差分区間を抽出し、claude -p に標準要約で漏れがちな観点だけを抽出させ additionalContext として注入するプラグイン",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/inject-handoff.mjs",
            "timeout": 200
          }
        ]
      }
    ]
  }
}
