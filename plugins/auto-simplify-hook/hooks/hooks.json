{
  "description": "Stopイベント時にgit diffの変更行数を確認し、10行以上の変更がある場合は /simplify の実行を促す",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-check-simplify.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
