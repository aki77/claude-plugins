{
  "description": "Plan モード運用ルールを UserPromptSubmit で注入し、Stop フックで plan 起点セッションのみ /simplify を促す",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/inject-rules.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/check-simplify.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
