{
  "description": "Plan モード運用ルールを UserPromptSubmit で注入する。ExitPlanMode では PreToolUse command フックがプランに plan-implementation スキルの記載があるか判定する",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/check-plan-skill.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/inject-rules.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
